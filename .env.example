# SQLite
DATABASE_URL=sqlite:linvlib.db

# Auth (required)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=168

# Aladin Open API (required)
ALADIN_TTB_KEY=
ALADIN_DAILY_QUOTA=5000
ALADIN_SOFT_QUOTA=4800

# Server
BIND_ADDR=0.0.0.0:3000
APP_BASE_URL=http://localhost:3000
TITLE_RULES_PATH=config/title_rules.toml
ADMIN_EMAIL=
RUST_LOG=info,linvlib=info,tower_http=info

# Email — leave SMTP_HOST empty for EMAIL_DEV_MODE (verification_token in API response)
EMAIL_DEV_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
