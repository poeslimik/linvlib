# SQLite
DATABASE_URL=sqlite:linvlib.db

# Auth (required)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=168

# Yes24 Open API (required) — https://developers.yes24.com/
# Header: X-Api-Key
YES24_API_KEY=

# Backups (optional)
BACKUP_DIR=backups
BACKUP_RETAIN_DAYS=14

# Discord daily status (optional) — Incoming Webhook URL; posts after the scheduled new-release refresh
DISCORD_STATUS_WEBHOOK_URL=

# Server
BIND_ADDR=0.0.0.0:3000
APP_BASE_URL=http://localhost:3000
TITLE_RULES_PATH=config/title_rules.toml
ADMIN_EMAIL=
RUST_LOG=info,linvlib=info,tower_http=info

# Email — leave SMTP_HOST empty for EMAIL_DEV_MODE (verification_token in API response)
EMAIL_DEV_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
